# Mommunjai environment (set these in Vercel Project Settings → Environment Variables)
# ⚠️ Use a dedicated Supabase project for this app.

# Supabase (SERVER ONLY — never expose service role to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing secret for staff/admin auth (Phase 2). REQUIRED in production.
# Generate: `openssl rand -base64 32`
SESSION_SECRET=

# Signs the "resume my questionnaire" link sent from the LINE OA menu
# (PDF-05/06, customer identity). REQUIRED in production. Never expose to client.
# Generate: `openssl rand -base64 32`
RESUME_TOKEN_SECRET=

# App public base URL (used in LINE Flex report link)
NEXT_PUBLIC_APP_URL=https://mommunjai.vercel.app

# LINE Messaging API (Phase 2 webhook + report push). From LINE Developers console.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# CORS allowlist for POST /api/lead when embedded cross-origin (comma-separated origins)
ALLOWED_ORIGINS=https://www.babyandmom.co.th

# CSP frame-ancestors — which sites may embed /tools/* as widgets
ALLOWED_FRAME_ANCESTORS='self' https://www.babyandmom.co.th

# Public LINE OA deep link shown on the success screen
NEXT_PUBLIC_LINE_OA_URL=https://lin.ee/fBa4xkz

# Optional: this LINE channel's webhook used to point directly at a third-party
# slip-verification service. A channel only has one webhook URL, so this app's
# own webhook now relays every raw event on to that service too (best-effort —
# an outage here never blocks this app's own bot flow). Leave blank to disable.
SLIP_CHECK_WEBHOOK_URL=

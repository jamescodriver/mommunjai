# Mommunjai environment (set these in Vercel Project Settings → Environment Variables)
# ⚠️ Use a dedicated Supabase project for this app.

# Supabase (SERVER ONLY — never expose service role to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing secret for staff/admin auth (Phase 2). REQUIRED in production.
# Generate: `openssl rand -base64 32`
SESSION_SECRET=

# Signs the "resume my questionnaire" link sent from the LINE OA menu
# (PDF-05/06, customer identity). REQUIRED in production. Never expose to client.
# Generate: `openssl rand -base64 32`
RESUME_TOKEN_SECRET=

# App public base URL (used in LINE Flex report link)
NEXT_PUBLIC_APP_URL=https://mommunjai.vercel.app

# LINE Messaging API (Phase 2 webhook + report push). From LINE Developers console.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── อยู่ร่วมกับบอทตัวอื่นบน LINE OA เดียวกัน ────────────────────────────────
# LINE OA ตั้ง Webhook URL ได้ช่องเดียว แต่ OA นี้มีบอทเช็คสลิป Thunder ใช้อยู่ก่อน
# วิธีแก้: ตั้ง Webhook URL ใน LINE Developers ให้ชี้มาที่ /api/line/webhook ของเรา
# แล้วเราส่งต่อ (relay) ทุก event ไปที่ URL ข้างล่างนี้ต่อให้เอง
#
# ⚠️ ถ้า "ไม่ตั้ง" ค่านี้ = โหมดเดิม (เราเป็นบอทตัวเดียวบน OA) ตอบทุกข้อความเหมือนก่อน
# ⚠️ ถ้า "ตั้ง" ค่านี้ = เราจะเงียบกับข้อความที่ไม่ใช่ของเรา (ไม่แย่ง replyToken บอทสลิป)
LINE_RELAY_WEBHOOK_URL=

# 🔴 KILL SWITCH — ปิดงานฝั่ง Mommunjai อย่างเดียว การส่งต่อ Thunder ยังทำงานปกติ
# ใช้ตอนฉุกเฉิน (บอทเราตอบมั่ว/ตอบชนบอทสลิป) โดยไม่ต้องแตะ LINE Console
# ไม่ตั้ง หรือค่าอื่น = เปิด · ใส่ 0 / false / off = ปิด
# ⚠️ แก้ค่าแล้วต้องกด Redeploy ใน Vercel (~1 นาที) ถึงจะมีผล
LINE_BOT_ENABLED=1

# CORS allowlist for POST /api/lead when embedded cross-origin (comma-separated origins)
ALLOWED_ORIGINS=https://www.babyandmom.co.th

# CSP frame-ancestors — which sites may embed /tools/* as widgets
ALLOWED_FRAME_ANCESTORS='self' https://www.babyandmom.co.th

# Public LINE OA deep link shown on the success screen
NEXT_PUBLIC_LINE_OA_URL=https://lin.ee/fBa4xkz

# ── ตรวจสลิปโอนเงินเอง (Thunder Solution API) ─────────────────────────────
# เอกสาร: https://document.thunder.in.th/th/v2/  ·  ดูวิธีใช้เต็ม: docs/SLIP-CHECK.md
#
# 🔴 ห้ามเปิดพร้อมกับ LINE_RELAY_WEBHOOK_URL — บอท 2 ตัวจะตอบภาพสลิปชนกัน
#    (replyToken ใช้ได้ครั้งเดียว) จะเปิดอันนี้ ต้องล้าง LINE_RELAY_WEBHOOK_URL ให้ว่าง
SLIP_CHECK_ENABLED=0

# API key จาก Thunder — 🔒 server-only ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit
THUNDER_API_KEY=

# เลขบัญชีผู้รับของร้าน (ใส่ได้หลายบัญชี คั่นด้วยจุลภาค) — 🔴 กันโกงที่สำคัญที่สุด
# ไม่ตั้ง = ระบบอ่านข้อมูลจากสลิปให้เฉย ๆ แต่ไม่รู้ว่าเงินเข้าบัญชีร้านจริงไหม
THUNDER_RECEIVER_ACCOUNT=

# เซ็นลิงก์ชั่วคราวที่ให้ Thunder มาดึงภาพสลิป (อายุ 2 นาที)
# ไม่ตั้ง = ใช้ LINE_CHANNEL_SECRET แทนโดยอัตโนมัติ
# generate: openssl rand -base64 32
SLIP_IMAGE_SECRET=
